# PostgreSQL 容器初始化与 API 连接共用这组凭据。
POSTGRES_USER=omniflow
POSTGRES_PASSWORD=replace-with-a-random-password
POSTGRES_DB=omniflow

# Redis 容器与 API 共用同一个密码。
REDIS_PASSWORD=replace-with-a-random-password
OMNIFLOW_REDIS_ADDR=redis:6379
OMNIFLOW_REDIS_PASSWORD=replace-with-the-same-redis-password

OMNIFLOW_APP_ENV=production
OMNIFLOW_SERVER_MODE=release
OMNIFLOW_LOG_FORMAT=json
OMNIFLOW_LOG_LEVEL=info

# 国内服务器构建镜像时可使用更稳定的镜像源。
OMNIFLOW_BUILD_GOPROXY=https://goproxy.cn,direct
OMNIFLOW_BUILD_ALPINE_MIRROR=mirrors.cloud.tencent.com
