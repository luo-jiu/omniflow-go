app:
  name: omniflow-go
  env: production
  version: 0.1.0

server:
  host: 0.0.0.0
  port: 8850
  mode: release
  read_timeout: 10s
  write_timeout: 15s
  idle_timeout: 60s
  shutdown_timeout: 10s

log:
  format: json
  level: info
  add_source: false
  console:
    enabled: true
    color: false
  file:
    enabled: false
    max_size_mb: 100
    max_backups: 10
    max_age_days: 30
    compress: true
    local_time: true

database:
  # 生产连接由 OMNIFLOW_DATABASE_HOST / USER / PASSWORD / NAME 等变量覆盖。
  dsn: postgres://invalid
  max_open_conns: 20
  max_idle_conns: 10
  conn_max_lifetime: 30m
  log_level: warn
  debug_sql: false

redis:
  # 生产地址和密码由 OMNIFLOW_REDIS_ADDR / OMNIFLOW_REDIS_PASSWORD 覆盖。
  addr: invalid:6379
  password: ""
  db: 0

storage:
  provider: minio

upload:
  chunk_size_bytes: 10485760
  session_ttl: 24h
